generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  staff     Staff[]
}

model Campaign {
  id                    String       @id @default(uuid())
  name                  String       @default("Medical Camp Deployment")
  organizationId        String
  organizingInstitution String
  chiefOrganizer        String
  campCode              String       @unique
  slugToken             String       @unique @default(uuid())
  department            String
  date                  DateTime
  status                String       @default("INITIALIZING")
  createdAt             DateTime     @default(now())
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patients              Patient[]

  @@index([organizationId])
  @@index([status])
}

model Staff {
  id             String         @id @default(uuid())
  organizationId String?
  deploymentId   String
  name           String
  designation    String
  staffId        String
  password       String
  role           String         // "DOCTOR", "NURSE", "PHARMACIST"
  createdAt      DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consultations  Consultation[]
  triaged        Patient[]      @relation("TriageNurse")

  @@unique([deploymentId, staffId])
  @@index([organizationId])
  @@index([deploymentId])
}

model Patient {
  id                 String         @id @default(uuid())
  campaignId         String
  name               String
  age                Int
  gender             String
  bloodGroup         String?
  phone              String?
  height             Float?
  weight             Float?
  bloodPressure      String?
  pulse              Int?
  tokenNumber        Int
  status             String         @default("REGISTERED")
  triageNurseId      String?
  allergies          String?
  pastSurgeries      String?
  currentMedications String?
  outOfStockNote     String?
  createdAt          DateTime       @default(now())

  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  triageNurse   Staff?         @relation("TriageNurse", fields: [triageNurseId], references: [id], onDelete: SetNull)
  consultations Consultation[]

  @@unique([campaignId, tokenNumber])
  @@unique([campaignId, phone])
  @@index([campaignId, status])
  @@index([status])
  @@index([triageNurseId])
}

model Consultation {
  id            String   @id @default(uuid())
  patientId     String
  doctorId      String?
  doctorName    String   // Kept for fallback/historical reference
  symptoms      String
  diagnosis     String
  prescriptions String
  createdAt     DateTime @default(now())

  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        Staff?   @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([doctorId])
}
